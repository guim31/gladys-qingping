{
  "manifest_version": 1,
  "type": "device",
  "name": "Qingping",
  "description": {
    "en": "Qingping air monitors and thermometers via the Qingping cloud: CO₂, particles, VOC, temperature.",
    "fr": "Moniteurs d'air et thermomètres Qingping via le cloud Qingping : CO₂, particules, COV, température.",
    "de": "Qingping-Luftmonitore und Thermometer über die Qingping-Cloud: CO₂, Feinstaub, VOC, Temperatur.",
    "es": "Monitores de aire y termómetros Qingping vía la nube Qingping: CO₂, partículas, COV, temperatura."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-qingping:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-qingping/main/cover.png",
  "categories": ["environment"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Qingping account",
        "fr": "Votre compte Qingping",
        "de": "Dein Qingping-Konto",
        "es": "Su cuenta Qingping"
      },
      "description": {
        "en": "Free. Log in to developer.qingping.co with your Qingping+ app account, open Access Management and copy the App Key and App Secret. Devices must be bound in the Qingping+ app (Qingping mode, not HomeKit).",
        "fr": "Gratuit. Connectez-vous à developer.qingping.co avec le compte de l'appli Qingping+, ouvrez Access Management et copiez l'App Key et l'App Secret. Les appareils doivent être ajoutés dans l'appli Qingping+ (mode Qingping, pas HomeKit).",
        "de": "Kostenlos. Melde dich mit dem Konto der Qingping+-App auf developer.qingping.co an, öffne Access Management und kopiere App Key und App Secret. Die Geräte müssen in der Qingping+-App eingebunden sein (Qingping-Modus, nicht HomeKit).",
        "es": "Gratuito. Inicie sesión en developer.qingping.co con la cuenta de la aplicación Qingping+, abra Access Management y copie la App Key y el App Secret. Los dispositivos deben estar en la aplicación Qingping+ (modo Qingping, no HomeKit)."
      },
      "links": [
        {
          "url": "https://developer.qingping.co/personal/permissionApply",
          "label": {
            "en": "Qingping Access Management",
            "fr": "Gestion des accès Qingping",
            "de": "Qingping-Zugriffsverwaltung",
            "es": "Gestión de accesos de Qingping"
          }
        }
      ]
    },
    {
      "key": "app_key",
      "type": "string",
      "label": {
        "en": "App Key",
        "fr": "App Key",
        "de": "App Key",
        "es": "App Key"
      },
      "description": {
        "en": "The App Key shown in Access Management on developer.qingping.co.",
        "fr": "L'App Key affichée dans Access Management sur developer.qingping.co.",
        "de": "Der App Key aus Access Management auf developer.qingping.co.",
        "es": "La App Key que aparece en Access Management en developer.qingping.co."
      },
      "placeholder": {
        "en": "e.g. 7Jk2Qx…",
        "fr": "ex. 7Jk2Qx…",
        "de": "z. B. 7Jk2Qx…",
        "es": "p. ej. 7Jk2Qx…"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "app_secret",
      "type": "secret",
      "label": {
        "en": "App Secret",
        "fr": "App Secret",
        "de": "App Secret",
        "es": "App Secret"
      },
      "description": {
        "en": "The App Secret next to the App Key. Kept by Gladys, never written to the logs.",
        "fr": "L'App Secret, à côté de l'App Key. Conservé par Gladys, jamais écrit dans les logs.",
        "de": "Das App Secret neben dem App Key. Von Gladys gespeichert, nie in die Protokolle geschrieben.",
        "es": "El App Secret, junto a la App Key. Gladys lo guarda y nunca aparece en los registros."
      },
      "required": true
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Cloud reading",
        "fr": "Lecture du cloud",
        "de": "Abfrage der Cloud",
        "es": "Lectura de la nube"
      },
      "description": {
        "en": "Automatic: right after each upload the devices are expected to make (their report interval, set in the Qingping+ app). Reading faster brings no fresher value.",
        "fr": "Automatique : juste après chaque remontée attendue des appareils (leur intervalle de remontée, réglé dans l'appli Qingping+). Lire plus souvent n'apporte aucune valeur plus fraîche.",
        "de": "Automatisch: direkt nach jeder erwarteten Übertragung der Geräte (ihr Sendeintervall aus der Qingping+-App). Häufigere Abfragen bringen keine frischeren Werte.",
        "es": "Automático: justo después de cada envío previsto de los dispositivos (su intervalo de envío, ajustado en la aplicación Qingping+). Leer más a menudo no aporta valores más recientes."
      },
      "required": false,
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": {
            "en": "Automatic (recommended)",
            "fr": "Automatique (conseillé)",
            "de": "Automatisch (empfohlen)",
            "es": "Automático (recomendado)"
          }
        },
        {
          "value": "5",
          "label": {
            "en": "Every 5 minutes",
            "fr": "Toutes les 5 minutes",
            "de": "Alle 5 Minuten",
            "es": "Cada 5 minutos"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "Every 10 minutes",
            "fr": "Toutes les 10 minutes",
            "de": "Alle 10 Minuten",
            "es": "Cada 10 minutos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "Every 15 minutes",
            "fr": "Toutes les 15 minutes",
            "de": "Alle 15 Minuten",
            "es": "Cada 15 minutos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "Every 30 minutes",
            "fr": "Toutes les 30 minutes",
            "de": "Alle 30 Minuten",
            "es": "Cada 30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "Every hour",
            "fr": "Toutes les heures",
            "de": "Jede Stunde",
            "es": "Cada hora"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the device features",
        "fr": "Langue des fonctionnalités",
        "de": "Sprache der Gerätefunktionen",
        "es": "Idioma de las funciones"
      },
      "description": {
        "en": "Names given to the features when a device is added, and language of the scene texts.",
        "fr": "Noms donnés aux fonctionnalités à l'ajout d'un appareil, et langue des textes des scènes.",
        "de": "Namen der Funktionen beim Hinzufügen eines Geräts und Sprache der Szenentexte.",
        "es": "Nombres de las funciones al añadir un dispositivo e idioma de los textos de escenas."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 60
    },
    {
      "key": "set_report_interval",
      "label": {
        "en": "Set the report interval",
        "fr": "Régler l'intervalle de remontée",
        "de": "Sendeintervall einstellen",
        "es": "Ajustar el intervalo de envío"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Air monitor",
            "fr": "Moniteur d'air",
            "de": "Luftmonitor",
            "es": "Monitor de aire"
          },
          "description": {
            "en": "Air monitors only. A short interval drains the battery much faster.",
            "fr": "Moniteurs d'air seulement. Un intervalle court vide la batterie bien plus vite.",
            "de": "Nur Luftmonitore. Ein kurzes Intervall leert den Akku viel schneller.",
            "es": "Solo monitores de aire. Un intervalo corto agota la batería mucho más rápido."
          }
        },
        {
          "key": "minutes",
          "type": "select",
          "label": {
            "en": "Upload every",
            "fr": "Remonter toutes les",
            "de": "Senden alle",
            "es": "Enviar cada"
          },
          "options": [
            {
              "value": "1",
              "label": {
                "en": "1 minute",
                "fr": "1 minute",
                "de": "1 Minute",
                "es": "1 minuto"
              }
            },
            {
              "value": "5",
              "label": {
                "en": "5 minutes",
                "fr": "5 minutes",
                "de": "5 Minuten",
                "es": "5 minutos"
              }
            },
            {
              "value": "10",
              "label": {
                "en": "10 minutes",
                "fr": "10 minutes",
                "de": "10 Minuten",
                "es": "10 minutos"
              }
            },
            {
              "value": "15",
              "label": {
                "en": "15 minutes",
                "fr": "15 minutes",
                "de": "15 Minuten",
                "es": "15 minutos"
              }
            },
            {
              "value": "30",
              "label": {
                "en": "30 minutes",
                "fr": "30 minutes",
                "de": "30 Minuten",
                "es": "30 minutos"
              }
            },
            {
              "value": "60",
              "label": {
                "en": "1 hour",
                "fr": "1 heure",
                "de": "1 Stunde",
                "es": "1 hora"
              }
            }
          ]
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "air_quality_changed",
      "label": {
        "en": "Air quality changed",
        "fr": "Qualité de l'air changée",
        "de": "Luftqualität geändert",
        "es": "Calidad del aire cambiada"
      },
      "description": {
        "en": "The air quality level of a monitor changed (CO₂, particles or VOC).",
        "fr": "Le niveau de qualité de l'air d'un moniteur a changé (CO₂, particules ou COV).",
        "de": "Die Luftqualitätsstufe eines Monitors hat sich geändert (CO₂, Feinstaub oder VOC).",
        "es": "El nivel de calidad del aire de un monitor ha cambiado (CO₂, partículas o COV)."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Monitor",
            "fr": "Moniteur",
            "de": "Monitor",
            "es": "Monitor"
          }
        },
        {
          "key": "level",
          "type": "multi_select",
          "label": {
            "en": "New level",
            "fr": "Nouveau niveau",
            "de": "Neue Stufe",
            "es": "Nuevo nivel"
          },
          "options": [
            {
              "value": "good",
              "label": {
                "en": "Good",
                "fr": "Bonne",
                "de": "Gut",
                "es": "Buena"
              }
            },
            {
              "value": "moderate",
              "label": {
                "en": "Moderate",
                "fr": "Moyenne",
                "de": "Mäßig",
                "es": "Moderada"
              }
            },
            {
              "value": "poor",
              "label": {
                "en": "Poor",
                "fr": "Mauvaise",
                "de": "Schlecht",
                "es": "Mala"
              }
            },
            {
              "value": "bad",
              "label": {
                "en": "Very poor",
                "fr": "Très mauvaise",
                "de": "Sehr schlecht",
                "es": "Muy mala"
              }
            }
          ]
        },
        {
          "key": "direction",
          "type": "select",
          "label": {
            "en": "Direction",
            "fr": "Sens",
            "de": "Richtung",
            "es": "Sentido"
          },
          "options": [
            {
              "value": "worse",
              "label": {
                "en": "Getting worse",
                "fr": "Se dégrade",
                "de": "Wird schlechter",
                "es": "Empeora"
              }
            },
            {
              "value": "better",
              "label": {
                "en": "Getting better",
                "fr": "S'améliore",
                "de": "Wird besser",
                "es": "Mejora"
              }
