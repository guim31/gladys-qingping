        "es": "Dispositivo sin datos"
      },
      "description": {
        "en": "No new reading for two report intervals, or the device is offline (battery, Wi-Fi).",
        "fr": "Aucune nouvelle mesure depuis deux intervalles de remontée, ou appareil hors ligne (batterie, Wi-Fi).",
        "de": "Seit zwei Sendeintervallen keine neue Messung, oder das Gerät ist offline (Akku, WLAN).",
        "es": "Ninguna medida nueva en dos intervalos de envío, o el dispositivo está sin conexión (batería, Wi-Fi)."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Device",
            "fr": "Appareil",
            "de": "Gerät",
            "es": "Dispositivo"
          }
        }
      ],
      "variables": [
        {
          "key": "device_name",
